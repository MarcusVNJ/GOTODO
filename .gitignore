# --- Binários e Build ---
# Binários Windows
*.exe
*.exe~
*.dll
*.so
*.dylib

# Binários Unix/Mac (Geralmente não têm extensão)
# Substitua "meu-app" pelo nome do executável que você gera no go build
main
app
bin/
dist/

# --- Testes e Coverage ---
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# --- Dependências ---
# vendor/ is usually recommended to be ignored unless you explicitly need it
# vendor/

# --- Go Workspace ---
go.work
go.work.sum

# --- Web Server / Chi Específico ---
# Logs da aplicação
*.log

# Arquivos de certificados locais (HTTPS) - CRÍTICO PARA SEGURANÇA
*.pem
*.key
*.csr
*.crt

# Uploads locais (caso seu app faça upload de arquivos)
uploads/
tmp/
public/assets/uploads/

# --- Configurações de Ambiente ---
.env
.env.local
.env.*.local

# --- Sistema Operacional (Lixo) ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDEs e Editores ---
.idea/
.vscode/
.fleet/
*.swp
*.swo

# --- AGENTS AI ---
# .agent/
# # opencode.json is versioned (project config without secrets)
opencode.local.jsonc

# --- OpenCode (Node internals, keep .opencode/agents/ versioned) ---
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/.gitignore
